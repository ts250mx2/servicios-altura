# Copia este archivo a .env y llena los valores reales.

# MySQL de la aplicación (aquí se lee y se escribe)
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=BDServiciosAltura
DB_CONNECTION_LIMIT=10

# Firma de la cookie de sesión: cadena larga y aleatoria, igual en dev y producción
JWT_SECRET=

# Asistente y respaldo de importación (fase 3). Opcional en fase 1.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
